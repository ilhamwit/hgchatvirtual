# Chat Center configuration. Production values live in
# ~/.config/chat-center.env (loaded by systemd: chat-center.service).
# Never commit real values. server.js refuses to start if a required value
# is missing, unless CHAT_DEV=1. Accounts are not configured here: they live in
# the database and are managed with `node scripts/users.js`.

# --- Required in production -------------------------------------------------
# OpenClaw gateway bearer token (gateway.auth.token). Full operator access to
# the gateway: keep it server-side only.
GATEWAY_TOKEN=

# --- Optional ---------------------------------------------------------------
# Listen port on 127.0.0.1 (default 8643; Cloudflare Tunnel points here).
CHAT_PORT=8643
# Where uploads are written for the agents (default ~/.openclaw/media/inbound).
CHAT_MEDIA_DIR=
# Max upload size in bytes (default 10 MB).
CHAT_MAX_UPLOAD_BYTES=10485760
# SQLite database with users, sessions and chat history (default data/chat-center.db, mode 600).
CHAT_DB_PATH=
# OpenClaw gateway base URL (default http://127.0.0.1:18789).
CHAT_GATEWAY_URL=
# OpenClaw agent ids the UI may use (default dave,jaden,joel,dylan,nana).
CHAT_AGENTS=

# --- Development ------------------------------------------------------------
# 1 = local dev: GATEWAY_TOKEN may be empty and the server starts even with no
# users (login is still required). Never set this in ~/.config/chat-center.env.
CHAT_DEV=
