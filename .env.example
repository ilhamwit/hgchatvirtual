# Chat Center configuration. Production values live in
# ~/.config/chat-center.env (loaded by systemd: chat-center.service).
# Never commit real values. server.js refuses to start if a required value
# is missing, unless CHAT_DEV=1. Accounts are not configured here: they live in
# the database and are managed with `node scripts/users.js`.

# --- Required in production -------------------------------------------------
# Hermes API server key. Must equal API_SERVER_KEY in the .env of every agent
# profile (~/.hermes/profiles/<agent>/.env). Keep it server-side only.
HERMES_API_KEY=

# --- Optional ---------------------------------------------------------------
# Listen port on 127.0.0.1 (default 8643; Cloudflare Tunnel points here).
CHAT_PORT=8643
# Where uploads are written for the agents (default ~/.openclaw/media/inbound).
CHAT_MEDIA_DIR=
# Max upload size in bytes (default 10 MB).
CHAT_MAX_UPLOAD_BYTES=10485760
# SQLite database with users, sessions and chat history (default data/chat-center.db, mode 600).
CHAT_DB_PATH=
# Hermes API server base URL (default http://127.0.0.1:8642; agents are /p/<profile>/).
CHAT_HERMES_URL=
# Hermes profile names the UI may use (default dave,jaden,joel,dylan,nana).
CHAT_AGENTS=

# --- Backup (scripts/backup.js, daily via chat-center-backup.timer) -----------
# Where backups go (default data/backups) and how many days to keep (default 14).
CHAT_BACKUP_DIR=
CHAT_BACKUP_KEEP_DAYS=14
# Optional second copy, e.g. a folder synced off this machine.
CHAT_BACKUP_COPY_DIR=

# --- WhatsApp (Koneksikan WA) — defaults match this server ---------------------
# Hermes install (default ~/.hermes), its WhatsApp session and bridge URL.
CHAT_HERMES_HOME=
CHAT_WA_SESSION_DIR=
CHAT_WA_BRIDGE_URL=
# Hermes' WhatsApp group archive, read only (default ~/.hermes/whatsapp/group_archive.jsonl).
CHAT_WA_ARCHIVE=
# Hermes' session store, read only, for the bot's own group replies (default ~/.hermes/state.db).
CHAT_HERMES_STATE_DB=
# Hermes profile that writes every group summary (default aurix; needs the shared API_SERVER_KEY).
CHAT_WA_SUMMARY_AGENT=

# --- Development ------------------------------------------------------------
# 1 = local dev: HERMES_API_KEY may be empty and the server starts even with no
# users (login is still required). Never set this in ~/.config/chat-center.env.
CHAT_DEV=
