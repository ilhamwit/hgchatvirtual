# Voice worker for Chat Center — written by scripts/install-voice.sh
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
HERMES_API_KEY=            # same shared key Chat Center uses (~/.config/chat-center.env)
CHAT_CENTER_VOICE_KEY=     # worker -> Chat Center transcript key (generated)
AGENT_NAME=hg-voice
STT_ENGINE=faster-whisper
WHISPER_MODEL=large-v3-turbo
TTS_ENGINE=omnivoice
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_STEPS=24
OMNIVOICE_GUIDANCE_SCALE=2.5
TTS_SPEED=1.0
NUM_IDLE_PROCESSES=1
